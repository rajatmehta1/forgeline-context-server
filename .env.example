# ForgeLine Context Server Configuration
# Copy to .env and fill in your values

# ─── Neo4j Knowledge Graph ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ─── PostgreSQL (policies, users, audit) ───
DATABASE_URL=postgresql+asyncpg://forgeline:password@localhost:5432/forgeline

# ─── Server Settings ───
SERVER_NAME=forgeline-context
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
TRANSPORT=stdio
LOG_LEVEL=INFO

# ─── Cache Settings ───
CACHE_TTL_SECONDS=300
PATTERN_CACHE_MAX_SIZE=500

# ─── ForgeLine API (optional, for cloud-managed policies) ───
FORGELINE_API_URL=
FORGELINE_API_KEY=
